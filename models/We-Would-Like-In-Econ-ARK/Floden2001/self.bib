@ARTICLE{Floden2001-yt,
  title     = "The effectiveness of government debt and transfers as insurance",
  author    = "Flodén, Martin",
  journal   = "J. Monet. Econ.",
  publisher = "Elsevier BV",
  volume    =  48,
  number    =  1,
  pages     = "81--108",
  abstract  = "Government debt and redistributive taxation can help people to
               smooth consumption when facing uninsurable individual specific
               risk. I examine the effects that variations in public debt and
               transfers have on risk sharing, efficiency, and the distribution
               of resources. I find that risk sharing can be improved
               significantly by both debt and transfers, but that debt has
               adverse effects on equity. When used in isolation, debt will
               enhance welfare if transfers are lower than optimal. However, the
               beneficial effects of public debt vanish if transfers are used
               optimally.",
  month     =  aug,
  year      =  2001,
  language  = "en"
}
